# Add these directives inside the existing Nginx server { ... } block.
# They protect the app and every route in this server, including /movies/.
auth_basic "Pocket Arcade";
auth_basic_user_file /etc/nginx/.htpasswd-pocket-arcade;

# Create the password file outside the public web directory:
#   sudo apt install apache2-utils
#   sudo htpasswd -c /etc/nginx/.htpasswd-pocket-arcade your_username
# On Debian/Ubuntu, allow Nginx to read it:
#   sudo chown root:www-data /etc/nginx/.htpasswd-pocket-arcade
#   sudo chmod 640 /etc/nginx/.htpasswd-pocket-arcade
# Then validate and reload Nginx:
#   sudo nginx -t && sudo systemctl reload nginx
#
# Serve this site over HTTPS. Basic Auth does not protect credentials over HTTP.
# This only protects content served by your Nginx server; it does not protect a
# separate GitHub Pages deployment.
